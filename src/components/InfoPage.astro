---
/** Gabarit temporaire pour les pages intérieures — composants dédiés à venir. */
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from './ProjectCard.astro';
import { pathFor, translation, type Locale, type RouteId } from '../i18n/ui';
interface Props { locale: Locale; page: Exclude<RouteId,'home'>; }
const { locale, page } = Astro.props;
const t = translation(locale);
const info = t.pages[page];
const isProject = page === 'matmatic' || page === 'vucs';
// SEO distinct du contenu visible, uniquement pour la page Solutions FR/EN.
const seoTitle = page === 'solutions' ? t.pages.solutions.seoTitle : info.title;
const seoDescription = page === 'solutions' ? t.pages.solutions.seoDescription : info.intro;
---
<SiteLayout locale={locale} route={page} title={seoTitle} description={seoDescription}>
  <section class="inner-hero section">
    <div class="container inner-copy">
      <span class="eyebrow">{info.label}</span>
      <h1>{info.title}</h1>
      <p>{info.intro}</p>
      {page === 'contact' || page === 'partners' ? <a class="button button-dark" href={`mailto:${t.general.email}?subject=${encodeURIComponent(page === 'partners' ? 'BlueKioskTech — Partenariat / Partnership' : 'BlueKioskTech — Contact')}`}>{t.general.contactUs} ↗</a> : null}
      {page === 'vucs' ? <a class="button button-outline" href="https://bluekiosk.tech/" target="_blank" rel="noopener noreferrer">{t.general.website} ↗</a> : null}
      {isProject ? <div class="info-note">{t.general.conceptNote}</div> : null}
    </div>
  </section>
  {page === 'solutions' ? <section class="section inner-solutions"><div class="container project-grid">
      <ProjectCard locale={locale} project="matmatic" />
      <ProjectCard locale={locale} project="vucs" />
    </div></section> : null}
  {isProject ? <section class="container inner-next"><a class="section-link" href={pathFor(locale,'solutions')}>← {t.general.back}</a></section> : null}
</SiteLayout>
