---
/**
 * BlueKioskTech — pied de page commun (Phase 2, lot L3.2).
 * Rôle : identité, navigation locale FR/EN et statut conceptuel des deux initiatives.
 * Décisions : conserver les routes et la marque ; ne pas créer de pages légales fictives.
 * Aucun changement aux formulaires, API, header ou déploiement.
 */
import Brand from './Brand.astro';
import { pathFor, translation, type Locale, type RouteId } from '../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translation(locale);
const links: RouteId[] = ['home', 'solutions', 'about', 'partners', 'contact'];
const labels = [t.nav.home, t.nav.solutions, t.nav.about, t.nav.partners, t.nav.contact];
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="footer-logo" href={pathFor(locale, 'home')} aria-label={`BlueKioskTech — ${t.nav.home}`}><Brand compact loading="lazy" /></a>
      <small>{t.general.footerLine}</small>
    </div>
    <nav class="footer-nav" aria-label={locale === 'fr' ? 'Navigation du pied de page' : 'Footer navigation'}>
      {links.map((id, i) => <a href={pathFor(locale, id)}>{labels[i]}</a>)}
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} BlueKioskTech. {t.general.rights}</span>
    <small class="footer-concept-note"><span class="footer-concept-dot" aria-hidden="true"></span>{t.general.conceptNote}</small>
  </div>
</footer>
<style>
  /* Le CSS du footer est isolé du header et des pages Solutions. */
  .site-footer { background:#fff;border-top:1px solid #e2eaf1;color:#546780;padding-top:34px; }
  .footer-main { display:flex;justify-content:space-between;align-items:flex-start;gap:26px;padding-bottom:30px; }
  .footer-brand { display:grid;gap:12px;min-width:0; }
  .footer-logo { display:inline-flex;width:max-content;max-width:100%;text-decoration:none; }
  .footer-brand small { font-size:.8rem;line-height:1.6;color:#5e748a; }
  .footer-nav { display:flex;gap:12px 23px;align-items:center;justify-content:flex-end;flex-wrap:wrap;max-width:640px; }
  .footer-nav a { text-decoration:none;color:#526982;font-size:.81rem;font-weight:650;line-height:1.5;padding:3px 0; }
  .footer-nav a:hover { color:#0667ac; }
  .footer-nav a:focus-visible,.footer-logo:focus-visible { outline:2px solid #1476b8;outline-offset:4px;border-radius:3px; }
  .footer-bottom { display:flex;justify-content:space-between;gap:12px 24px;align-items:center;flex-wrap:wrap;border-top:1px solid #e7edf3;padding-block:17px 22px;font-size:.77rem;line-height:1.5; }
  .footer-concept-note { display:inline-flex;align-items:center;gap:8px;color:#617990;font-size:.75rem; }
  .footer-concept-dot { display:inline-block;width:7px;height:7px;background:#2bb667;border-radius:100%;flex:none; }
  @media(max-width:800px) {
    .footer-main { flex-direction:column;gap:18px; }
    .footer-nav { justify-content:flex-start;gap:10px 19px; }
  }
  @media(max-width:520px) {
    .site-footer { padding-top:27px; }
    .footer-main { padding-bottom:25px; }
    .footer-bottom { align-items:flex-start;flex-direction:column; }
  }
</style>
