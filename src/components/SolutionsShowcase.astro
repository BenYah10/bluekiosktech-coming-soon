---
/**
 * BlueKioskTech — section « Nos projets en développement » (étape 1.3).
 * Conserve la hiérarchie de la maquette V3 et la parité MatMatic/VUCS.
 * Aucune donnée inventée ni logo de marque concurrente.
 * Les textes de navigation viennent exclusivement du dictionnaire central FR/EN.
 */
import ProjectCard from './ProjectCard.astro';
import { pathFor, translation, type Locale } from '../i18n/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translation(locale).home;
---
<section class="bkt-showcase section" id="solutions" aria-labelledby="bkt-showcase-heading">
  <div class="container">
    <header class="bkt-showcase-heading">
      <div class="bkt-showcase-heading-copy">
        <span class="eyebrow">{t.projectsEyebrow}</span>
        <h2 id="bkt-showcase-heading">{t.projectsTitle}</h2>
        <p>{t.projectsLead}</p>
      </div>
      <a href={pathFor(locale,'solutions')} class="bkt-showcase-more">{t.projectsAllLink} <span aria-hidden="true">↗</span></a>
    </header>
    <div class="project-grid bkt-showcase-grid">
      <ProjectCard locale={locale} project="matmatic" />
      <ProjectCard locale={locale} project="vucs" />
    </div>
    <p class="bkt-showcase-disclaimer">{t.projectsDisclaimer}</p>
  </div>
</section>
<style>
  .bkt-showcase { background:linear-gradient(180deg,#fff 0%,#f4f8fb 95%); }
  .bkt-showcase-heading { display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:32px; }
  .bkt-showcase-heading-copy { max-width:680px; }
  .bkt-showcase-heading h2 { color:#102b4c;font-size:clamp(2.1rem,3.2vw,3.2rem);line-height:1.1;letter-spacing:-.045em;margin:14px 0 17px;text-wrap:balance; }
  .bkt-showcase-heading p { margin:0;color:#5b7085;max-width:590px;font-size:1.04rem; }
  .bkt-showcase-more { flex-shrink:0;text-decoration:none;color:#0a609f;font-size:.87rem;font-weight:800;padding-bottom:5px;border-bottom:1px solid #76b5df;display:inline-flex;align-items:center;gap:13px; }
  .bkt-showcase-more span { transition:transform .24s ease; }
  .bkt-showcase-more:hover span { transform:translate(3px,-3px); }
  .bkt-showcase-grid { align-items:stretch; }
  .bkt-showcase-disclaimer { font-size:.78rem;line-height:1.5;color:#687c8f;margin:22px 0 0; }
  @media(max-width:780px) { .bkt-showcase-heading { flex-direction:column;align-items:start;gap:18px; }.bkt-showcase-heading h2 { font-size:clamp(2.1rem,8vw,3rem); } }
  @media(prefers-reduced-motion:reduce) { .bkt-showcase-more span { transition:none; }.bkt-showcase-more:hover span { transform:none; } }
</style>
